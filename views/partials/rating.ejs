<% 
  const val = typeof rating !== 'undefined' ? parseFloat(rating) : 0;
  const fullStars = Math.floor(val);
  const hasHalf = (val % 1) >= 0.5;
  const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
%>
<span class="rating-stars d-inline-flex align-items-center gap-1">
  <% for (let i = 0; i < fullStars; i++) { %>
    <i class="fa-solid fa-star text-warning"></i>
  <% } %>
  <% if (hasHalf) { %>
    <i class="fa-solid fa-star-half-stroke text-warning"></i>
  <% } %>
  <% for (let i = 0; i < emptyStars; i++) { %>
    <i class="fa-regular fa-star text-muted opacity-50"></i>
  <% } %>
  <span class="ms-1 fw-bold text-dark"><%= val > 0 ? val.toFixed(1) : 'No Ratings' %></span>
</span>
