<div class="dashboard-wrapper container-fluid p-0">
  <div class="row g-0 min-vh-100">
    
    <!-- CUSTOMER DASHBOARD SIDEBAR -->
    <aside class="col-lg-2 bg-dark text-white p-3 dashboard-sidebar d-flex flex-column" id="dashboardSidebar">
      <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom border-secondary opacity-75">
        <a href="/" class="d-flex align-items-center gap-2 text-white text-decoration-none">
          <div class="brand-icon-box bg-primary text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
            <i class="fa-solid fa-car-side"></i>
          </div>
          <span class="fw-bold fs-5">Ride<span class="text-primary">Go</span></span>
        </a>
        <button class="btn btn-sm btn-outline-secondary text-white d-lg-none" id="closeSidebarBtn">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Navigation Menu -->
      <ul class="nav nav-pills flex-column mb-auto dashboard-nav gap-1">
        <li class="nav-item">
          <a href="/customer/dashboard" class="nav-link active bg-primary text-white d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold">
            <i class="fa-solid fa-gauge"></i> Dashboard
          </a>
        </li>
        <li class="nav-item">
          <a href="/customer/rides/new" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-taxi text-warning"></i> Book a Ride
          </a>
        </li>
        <li class="nav-item">
          <a href="/customer/rides" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-clock-rotate-left"></i> My Rides
          </a>
        </li>
        <li class="nav-item">
          <a href="/profile" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-user"></i> Profile
          </a>
        </li>
      </ul>

      <!-- Sidebar User Profile Footer -->
      <div class="pt-3 mt-auto border-top border-secondary opacity-75">
        <div class="d-flex align-items-center gap-2 mb-3">
          <div class="avatar-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-user"></i>
          </div>
          <div class="overflow-hidden">
            <h6 class="mb-0 text-white fw-bold text-truncate"><%= user.fullName %></h6>
            <span class="badge bg-success-subtle text-success small px-2 py-0">Rider Account</span>
          </div>
        </div>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-semibold">
            <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
          </button>
        </form>
      </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <main class="col-lg-10 bg-light p-3 p-md-4 dashboard-main">
      
      <!-- Top Bar Welcome Section -->
      <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-primary d-lg-none" id="openSidebarBtn">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div>
            <h4 class="fw-bold text-dark mb-0">Welcome back, <%= user.fullName %></h4>
            <small class="text-muted">Manage your bookings and travel history</small>
          </div>
        </div>
        <a href="/customer/rides/new" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
          <i class="fa-solid fa-taxi me-1"></i> Book a Ride
        </a>
      </div>

      <% if (stats.totalRides === 0) { %>
        <!-- EMPTY STATE (Zero Rides) -->
        <div class="card border-0 shadow-lg rounded-4 text-center p-5 mb-4 bg-white">
          <div class="max-w-600 mx-auto py-3">
            <div class="icon-box-lg bg-primary-subtle text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
              <i class="fa-solid fa-car-side display-4"></i>
            </div>
            <h3 class="fw-extrabold text-dark mb-2">No rides yet</h3>
            <p class="text-muted mb-4 fs-5">Start your first journey with RideGo.</p>
            <a href="/customer/rides/new" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow">
              <i class="fa-solid fa-taxi me-2"></i> Book Your First Ride
            </a>
          </div>
        </div>
      <% } else { %>

        <!-- ACTIVE RIDE SECTION -->
        <div class="mb-4">
          <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-bolt text-warning me-2"></i> Active Ride</h5>
          
          <% if (typeof activeRide !== 'undefined' && activeRide) { %>
            <div class="card border-0 shadow-md rounded-4 overflow-hidden bg-white">
              <div class="card-header bg-warning text-dark p-3 d-flex justify-content-between align-items-center fw-bold border-0">
                <div>
                  <i class="fa-solid fa-spinner fa-spin me-2"></i> Active Booking: <span class="font-monospace"><%= activeRide.bookingId %></span>
                </div>
                <span class="badge bg-dark text-white uppercase"><%= activeRide.status %></span>
              </div>
              <div class="card-body p-4">
                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <span class="text-muted small fw-semibold d-block">Pickup Location</span>
                    <strong class="text-dark"><i class="fa-solid fa-circle text-success me-1"></i> <%= activeRide.pickup.address %></strong>
                  </div>
                  <div class="col-md-6">
                    <span class="text-muted small fw-semibold d-block">Destination</span>
                    <strong class="text-dark"><i class="fa-solid fa-location-dot text-danger me-1"></i> <%= activeRide.destination.address %></strong>
                  </div>
                  <div class="col-md-3">
                    <span class="text-muted small fw-semibold d-block">Ride Type</span>
                    <span class="badge bg-primary-subtle text-primary uppercase fw-bold"><%= activeRide.rideType %></span>
                  </div>
                  <div class="col-md-3">
                    <span class="text-muted small fw-semibold d-block">Fare</span>
                    <strong class="text-success fs-5">Rs. <%= activeRide.fare %></strong>
                  </div>
                  <div class="col-md-6">
                    <span class="text-muted small fw-semibold d-block">Assigned Driver</span>
                    <% if (activeRide.driver && activeRide.driver.user) { %>
                      <strong class="text-dark"><%= activeRide.driver.user.fullName %> (<%= activeRide.driver.user.phone %>)</strong>
                    <% } else { %>
                      <span class="text-warning fw-bold"><i class="fa-solid fa-clock me-1"></i> Finding your driver...</span>
                    <% } %>
                  </div>
                </div>
                <div class="text-end border-top pt-3">
                  <a href="/customer/rides/<%= activeRide._id %>" class="btn btn-primary rounded-pill px-4 fw-bold">
                    View Full Details & Manage
                  </a>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
              <div class="d-flex align-items-center gap-3">
                <div class="bg-light text-muted p-3 rounded-circle">
                  <i class="fa-solid fa-car fs-4"></i>
                </div>
                <div>
                  <h6 class="fw-bold text-dark mb-1">You don't have an active ride.</h6>
                  <small class="text-muted">Need to get somewhere? Book a ride in seconds.</small>
                </div>
              </div>
              <a href="/customer/rides/new" class="btn btn-outline-primary rounded-pill fw-bold px-4">
                <i class="fa-solid fa-taxi me-1"></i> Book a Ride
              </a>
            </div>
          <% } %>
        </div>

        <!-- REAL MONGODB STATISTICS CARDS -->
        <div class="row g-3 mb-4">
          <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <span class="text-muted small fw-semibold d-block mb-1">Total Rides</span>
                  <h3 class="fw-bold text-dark mb-0"><%= stats.totalRides %></h3>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-4">
                  <i class="fa-solid fa-car-side fs-4"></i>
                </div>
              </div>
              <div class="mt-3 small text-muted">All-time bookings</div>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <span class="text-muted small fw-semibold d-block mb-1">Completed Rides</span>
                  <h3 class="fw-bold text-dark mb-0"><%= stats.completedRides %></h3>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-4">
                  <i class="fa-solid fa-circle-check fs-4"></i>
                </div>
              </div>
              <div class="mt-3 small text-muted">Finished trips</div>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <span class="text-muted small fw-semibold d-block mb-1">Cancelled Rides</span>
                  <h3 class="fw-bold text-dark mb-0"><%= stats.cancelledRides %></h3>
                </div>
                <div class="bg-danger-subtle text-danger p-3 rounded-4">
                  <i class="fa-solid fa-ban fs-4"></i>
                </div>
              </div>
              <div class="mt-3 small text-muted">Cancelled bookings</div>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
              <div class="d-flex align-items-center justify-content-between">
                <div>
                  <span class="text-muted small fw-semibold d-block mb-1">Active Ride</span>
                  <h3 class="fw-bold text-dark mb-0"><%= stats.activeRidesCount %></h3>
                </div>
                <div class="bg-warning-subtle text-warning-emphasis p-3 rounded-4">
                  <i class="fa-solid fa-route fs-4"></i>
                </div>
              </div>
              <div class="mt-3 small text-muted">Currently active</div>
            </div>
          </div>
        </div>

        <!-- RECENT RIDES TABLE (Latest 5 Rides) -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> Recent Rides</h5>
            <a href="/customer/rides" class="text-primary small text-decoration-none fw-semibold">View All Rides &rarr;</a>
          </div>

          <% if (typeof recentRides !== 'undefined' && recentRides.length > 0) { %>
            <!-- DESKTOP TABLE VIEW -->
            <div class="table-responsive d-none d-md-block">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th scope="col" class="small text-muted">Booking ID</th>
                    <th scope="col" class="small text-muted">Pickup</th>
                    <th scope="col" class="small text-muted">Destination</th>
                    <th scope="col" class="small text-muted">Ride Type</th>
                    <th scope="col" class="small text-muted">Fare</th>
                    <th scope="col" class="small text-muted">Status</th>
                    <th scope="col" class="small text-muted">Date</th>
                    <th scope="col" class="small text-muted text-end">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentRides.forEach(function(ride) { %>
                    <tr>
                      <td class="fw-bold font-monospace text-primary"><%= ride.bookingId %></td>
                      <td class="text-truncate small" style="max-width: 150px;"><%= ride.pickup.address %></td>
                      <td class="text-truncate small" style="max-width: 150px;"><%= ride.destination.address %></td>
                      <td><span class="badge bg-primary-subtle text-primary uppercase fw-bold"><%= ride.rideType %></span></td>
                      <td class="fw-bold text-dark">Rs. <%= ride.fare %></td>
                      <td>
                        <% if (ride.status === 'requested') { %>
                          <span class="badge bg-warning-subtle text-warning-emphasis">Requested</span>
                        <% } else if (ride.status === 'completed') { %>
                          <span class="badge bg-success-subtle text-success">Completed</span>
                        <% } else if (ride.status === 'cancelled') { %>
                          <span class="badge bg-danger-subtle text-danger">Cancelled</span>
                        <% } else { %>
                          <span class="badge bg-info-subtle text-info">In Progress</span>
                        <% } %>
                      </td>
                      <td class="small text-muted"><%= new Date(ride.createdAt).toLocaleDateString() %></td>
                      <td class="text-end">
                        <a href="/customer/rides/<%= ride._id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                          View
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <!-- MOBILE CARD VIEW -->
            <div class="d-block d-md-none">
              <% recentRides.forEach(function(ride) { %>
                <div class="card border rounded-3 p-3 mb-3 bg-white">
                  <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                    <span class="fw-bold font-monospace text-primary small"><%= ride.bookingId %></span>
                    <% if (ride.status === 'requested') { %>
                      <span class="badge bg-warning-subtle text-warning-emphasis">Requested</span>
                    <% } else if (ride.status === 'completed') { %>
                      <span class="badge bg-success-subtle text-success">Completed</span>
                    <% } else if (ride.status === 'cancelled') { %>
                      <span class="badge bg-danger-subtle text-danger">Cancelled</span>
                    <% } else { %>
                      <span class="badge bg-info-subtle text-info">In Progress</span>
                    <% } %>
                  </div>
                  <div class="mb-2">
                    <div class="small text-muted mb-1"><i class="fa-solid fa-circle text-success me-1 fs-8"></i> <%= ride.pickup.address %></div>
                    <div class="small text-dark fw-semibold"><i class="fa-solid fa-location-dot text-danger me-1 fs-8"></i> <%= ride.destination.address %></div>
                  </div>
                  <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
                    <div>
                      <span class="badge bg-primary-subtle text-primary uppercase me-1"><%= ride.rideType %></span>
                      <strong class="text-dark small">Rs. <%= ride.fare %></strong>
                    </div>
                    <a href="/customer/rides/<%= ride._id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">View</a>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="text-center py-4 text-muted">
              <p class="mb-0">No recent rides found.</p>
            </div>
          <% } %>
        </div>

      <% } %>

    </main>
  </div>
</div>
