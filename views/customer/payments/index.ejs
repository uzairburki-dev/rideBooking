<div class="container py-4 my-md-2">
  
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="fw-extrabold text-dark mb-1">My Payment History</h3>
      <p class="text-muted mb-0">View payment receipts, transaction references, and payment statuses</p>
    </div>
    <a href="/customer/dashboard" class="btn btn-outline-secondary rounded-pill fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
    </a>
  </div>

  <% 
    const paidPayments = payments.filter(p => p.status === 'paid');
    const totalPaidAmount = paidPayments.reduce((sum, p) => sum + p.amount, 0);
  %>

  <!-- Stat Overview Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold d-block mb-1">Total Paid Amount</span>
            <h3 class="fw-bold text-success mb-0">Rs. <%= totalPaidAmount %></h3>
          </div>
          <div class="bg-success-subtle text-success p-3 rounded-4">
            <i class="fa-solid fa-wallet fs-4"></i>
          </div>
        </div>
        <div class="mt-3 small text-muted">All successful payments</div>
      </div>
    </div>

    <div class="col-sm-6 col-md-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold d-block mb-1">Total Transactions</span>
            <h3 class="fw-bold text-dark mb-0"><%= payments.length %></h3>
          </div>
          <div class="bg-primary-subtle text-primary p-3 rounded-4">
            <i class="fa-solid fa-receipt fs-4"></i>
          </div>
        </div>
        <div class="mt-3 small text-muted">Total payment records</div>
      </div>
    </div>

    <div class="col-sm-6 col-md-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold d-block mb-1">Successful Payments</span>
            <h3 class="fw-bold text-dark mb-0"><%= paidPayments.length %></h3>
          </div>
          <div class="bg-warning-subtle text-warning-emphasis p-3 rounded-4">
            <i class="fa-solid fa-circle-check fs-4"></i>
          </div>
        </div>
        <div class="mt-3 small text-muted">Settled payments</div>
      </div>
    </div>
  </div>

  <!-- Payments Table Card -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-dark text-white p-3 fw-bold border-0 d-flex justify-content-between align-items-center">
      <span><i class="fa-solid fa-list-check text-warning me-2"></i> Payment Records</span>
      <span class="badge bg-secondary rounded-pill"><%= payments.length %> Payments</span>
    </div>

    <% if (payments && payments.length > 0) { %>
      
      <!-- DESKTOP TABLE VIEW -->
      <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="py-3 ps-4">Txn Reference</th>
              <th scope="col" class="py-3">Booking ID</th>
              <th scope="col" class="py-3">Amount</th>
              <th scope="col" class="py-3">Method</th>
              <th scope="col" class="py-3">Status</th>
              <th scope="col" class="py-3">Date</th>
              <th scope="col" class="py-3 pe-4 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% payments.forEach(function(p) { %>
              <tr>
                <td class="ps-4 fw-bold font-monospace text-primary"><%= p.transactionReference %></td>
                <td class="fw-semibold font-monospace text-dark"><%= p.ride ? p.ride.bookingId : 'N/A' %></td>
                <td class="fw-extrabold text-success">Rs. <%= p.amount %></td>
                <td><span class="badge bg-light text-dark border"><%= p.method %></span></td>
                <td>
                  <% if (p.status === 'paid') { %>
                    <span class="badge bg-success-subtle text-success">Paid</span>
                  <% } else if (p.status === 'pending') { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis">Pending</span>
                  <% } else if (p.status === 'failed') { %>
                    <span class="badge bg-danger-subtle text-danger">Failed</span>
                  <% } else { %>
                    <span class="badge bg-secondary uppercase"><%= p.status %></span>
                  <% } %>
                </td>
                <td class="small text-muted"><%= new Date(p.createdAt).toLocaleDateString() %></td>
                <td class="pe-4 text-end">
                  <a href="/customer/payments/details/<%= p._id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                    Details
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- MOBILE CARD VIEW -->
      <div class="d-block d-md-none p-3">
        <% payments.forEach(function(p) { %>
          <div class="card border rounded-3 p-3 mb-3 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
              <span class="fw-bold font-monospace text-primary small"><%= p.transactionReference %></span>
              <% if (p.status === 'paid') { %>
                <span class="badge bg-success-subtle text-success">Paid</span>
              <% } else if (p.status === 'pending') { %>
                <span class="badge bg-warning-subtle text-warning-emphasis">Pending</span>
              <% } else if (p.status === 'failed') { %>
                <span class="badge bg-danger-subtle text-danger">Failed</span>
              <% } else { %>
                <span class="badge bg-secondary uppercase"><%= p.status %></span>
              <% } %>
            </div>
            <div class="mb-2">
              <div class="small text-muted">Booking: <strong class="text-dark font-monospace"><%= p.ride ? p.ride.bookingId : 'N/A' %></strong></div>
              <div class="small text-muted">Method: <span class="badge bg-light text-dark border me-1"><%= p.method %></span> Date: <%= new Date(p.createdAt).toLocaleDateString() %></div>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
              <span class="fw-extrabold text-success fs-5">Rs. <%= p.amount %></span>
              <a href="/customer/payments/details/<%= p._id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">Details</a>
            </div>
          </div>
        <% }); %>
      </div>

    <% } else { %>
      <!-- Empty State -->
      <div class="text-center py-5">
        <i class="fa-solid fa-receipt text-muted fs-1 mb-2 opacity-50"></i>
        <h5 class="fw-bold text-dark mb-1">No payment history yet</h5>
        <p class="text-muted mb-4">Your completed ride payments will appear here.</p>
        <a href="/customer/rides" class="btn btn-primary rounded-pill px-4 fw-bold">
          <i class="fa-solid fa-car-side me-1"></i> View My Rides
        </a>
      </div>
    <% } %>
  </div>

</div>
