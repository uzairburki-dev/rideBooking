<div class="container py-4 my-md-2">
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="fw-extrabold text-dark mb-1">Driver Earnings Console</h3>
      <p class="text-muted mb-0">Track payouts and completed trip earnings</p>
    </div>
    <a href="/driver/dashboard" class="btn btn-outline-secondary rounded-pill fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
    </a>
  </div>

  <!-- Earnings Stat Cards Grid -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold d-block mb-1">Today's Earnings</span>
            <h3 class="fw-bold text-success mb-0">Rs. <%= stats.todayEarnings %></h3>
          </div>
          <div class="bg-success-subtle text-success p-3 rounded-4">
            <i class="fa-solid fa-calendar-day fs-4"></i>
          </div>
        </div>
        <div class="mt-3 small text-muted"><%= stats.todayCount %> completed today</div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold d-block mb-1">Total Earnings</span>
            <h3 class="fw-bold text-dark mb-0">Rs. <%= stats.totalEarnings %></h3>
          </div>
          <div class="bg-primary-subtle text-primary p-3 rounded-4">
            <i class="fa-solid fa-vault fs-4"></i>
          </div>
        </div>
        <div class="mt-3 small text-muted">All-time payouts</div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold d-block mb-1">Completed Trips</span>
            <h3 class="fw-bold text-dark mb-0"><%= stats.completedCount %></h3>
          </div>
          <div class="bg-warning-subtle text-warning-emphasis p-3 rounded-4">
            <i class="fa-solid fa-circle-check fs-4"></i>
          </div>
        </div>
        <div class="mt-3 small text-muted">Finished trips</div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold d-block mb-1">Average Fare / Trip</span>
            <h3 class="fw-bold text-dark mb-0">Rs. <%= stats.avgFare %></h3>
          </div>
          <div class="bg-dark text-white p-3 rounded-4">
            <i class="fa-solid fa-calculator fs-4"></i>
          </div>
        </div>
        <div class="mt-3 small text-muted">Avg payout per ride</div>
      </div>
    </div>
  </div>

  <!-- Completed Trips Earnings Breakdown -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-dark text-white p-3 fw-bold border-0">
      <i class="fa-solid fa-list text-warning me-2"></i> Completed Trip Payout Log
    </div>

    <% if (completedRides && completedRides.length > 0) { %>
      
      <!-- DESKTOP TABLE VIEW -->
      <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="py-3 ps-4">Booking ID</th>
              <th scope="col" class="py-3">Passenger</th>
              <th scope="col" class="py-3">Tier & Distance</th>
              <th scope="col" class="py-3">Payment Status</th>
              <th scope="col" class="py-3">Completed Date</th>
              <th scope="col" class="py-3 pe-4 text-end">Payout Amount</th>
            </tr>
          </thead>
          <tbody>
            <% completedRides.forEach(function(r) { %>
              <tr>
                <td class="ps-4 fw-bold font-monospace text-dark"><%= r.bookingId %></td>
                <td class="fw-semibold text-dark"><%= r.customer ? r.customer.fullName : 'Passenger' %></td>
                <td>
                  <span class="badge bg-primary-subtle text-primary me-1"><%= r.rideType %></span>
                  <small class="text-muted"><%= r.distance %> KM</small>
                </td>
                <td>
                  <span class="badge bg-success-subtle text-success fw-bold uppercase">PAID</span>
                </td>
                <td>
                  <small class="text-muted"><%= new Date(r.completedAt || r.updatedAt).toLocaleString() %></small>
                </td>
                <td class="pe-4 text-end">
                  <span class="fw-extrabold text-success fs-5">Rs. <%= r.fare %></span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- MOBILE CARD VIEW -->
      <div class="d-block d-md-none p-3">
        <% completedRides.forEach(function(r) { %>
          <div class="card border rounded-3 p-3 mb-3 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
              <span class="fw-bold font-monospace text-dark small"><%= r.bookingId %></span>
              <span class="badge bg-success-subtle text-success fw-bold uppercase">PAID</span>
            </div>
            <div class="mb-2">
              <div class="small fw-semibold text-dark mb-1"><i class="fa-solid fa-user me-1 text-muted"></i> Passenger: <%= r.customer ? r.customer.fullName : 'Passenger' %></div>
              <div class="small text-muted">Tier: <span class="badge bg-primary-subtle text-primary me-1"><%= r.rideType %></span> (<%= r.distance %> KM)</div>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
              <small class="text-muted"><%= new Date(r.completedAt || r.updatedAt).toLocaleDateString() %></small>
              <span class="fw-extrabold text-success fs-5">Rs. <%= r.fare %></span>
            </div>
          </div>
        <% }); %>
      </div>

    <% } else { %>
      <!-- Empty State -->
      <div class="text-center py-5">
        <i class="fa-solid fa-hand-holding-dollar text-muted fs-1 mb-2 opacity-50"></i>
        <h5 class="fw-bold text-dark mb-1">No earnings yet</h5>
        <p class="text-muted mb-0">Complete your first ride to start generating earnings.</p>
      </div>
    <% } %>
  </div>

</div>
