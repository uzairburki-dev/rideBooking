<div class="dashboard-wrapper container-fluid p-0">
  <div class="row g-0 min-vh-100">
    
    <!-- DRIVER DASHBOARD SIDEBAR -->
    <aside class="col-lg-2 bg-dark text-white p-3 dashboard-sidebar d-flex flex-column" id="dashboardSidebar">
      <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom border-secondary opacity-75">
        <a href="/" class="d-flex align-items-center gap-2 text-white text-decoration-none">
          <div class="brand-icon-box bg-warning text-dark rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
            <i class="fa-solid fa-car-side"></i>
          </div>
          <span class="fw-bold fs-5">Ride<span class="text-primary">Go</span></span>
        </a>
        <button class="btn btn-sm btn-outline-secondary text-white d-lg-none" id="closeSidebarBtn">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Navigation Menu -->
      <ul class="nav nav-pills flex-column mb-auto dashboard-nav gap-1">
        <li class="nav-item">
          <a href="/driver/dashboard" class="nav-link active bg-warning text-dark d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-bold">
            <i class="fa-solid fa-gauge"></i> Dashboard
          </a>
        </li>
        <li class="nav-item">
          <a href="/driver/rides/requests" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-list-check text-warning"></i> Ride Requests
          </a>
        </li>
        <li class="nav-item">
          <a href="/driver/rides/current" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-taxi"></i> Current Ride
          </a>
        </li>
        <li class="nav-item">
          <a href="/driver/rides/history" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-clock-rotate-left"></i> Ride History
          </a>
        </li>
        <li class="nav-item">
          <a href="/driver/earnings" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-wallet text-success"></i> Earnings
          </a>
        </li>
        <li class="nav-item">
          <a href="/driver/ratings" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-star text-warning"></i> Customer Ratings
          </a>
        </li>
        <li class="nav-item">
          <a href="/driver/profile" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-id-card"></i> Profile
          </a>
        </li>
      </ul>

      <!-- User Profile Footer -->
      <div class="pt-3 mt-auto border-top border-secondary opacity-75">
        <div class="d-flex align-items-center gap-2 mb-3">
          <div class="avatar-circle bg-warning text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-id-card-clip"></i>
          </div>
          <div class="overflow-hidden">
            <h6 class="mb-0 text-white fw-bold text-truncate"><%= user.fullName %></h6>
            <span class="badge bg-warning text-dark small px-2 py-0">Driver Fleet</span>
          </div>
        </div>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-semibold">
            <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
          </button>
        </form>
      </div>
    </aside>

    <!-- MAIN CONSOLE AREA -->
    <main class="col-lg-10 bg-light p-3 p-md-4 dashboard-main">
      
      <!-- Top Bar Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-dark d-lg-none" id="openSidebarBtn">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div>
            <h4 class="fw-bold text-dark mb-0">Welcome back, <%= user.fullName %>! 👋</h4>
            <small class="text-muted">Driver Operational Console</small>
          </div>
        </div>
        
        <div class="d-flex align-items-center gap-3">
          <!-- ONLINE / OFFLINE TOGGLE FORM -->
          <% if (driver && driver.isApproved) { %>
            <form action="/driver/status" method="POST" class="d-inline">
              <% if (driver.driverStatus === 'online') { %>
                <input type="hidden" name="status" value="offline">
                <button type="submit" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm d-flex align-items-center gap-2">
                  <span class="spinner-grow spinner-grow-sm text-white" role="status"></span> ONLINE (Go Offline)
                </button>
              <% } else { %>
                <input type="hidden" name="status" value="online">
                <button type="submit" class="btn btn-outline-secondary text-dark rounded-pill px-4 py-2 fw-bold shadow-sm d-flex align-items-center gap-2">
                  <i class="fa-solid fa-power-off text-danger"></i> OFFLINE (Go Online)
                </button>
              <% } %>
            </form>
          <% } else { %>
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
              <i class="fa-solid fa-clock me-1"></i> Pending Approval
            </span>
          <% } %>
        </div>
      </div>

      <!-- Pending Approval Warning Banner -->
      <% if (driver && !driver.isApproved) { %>
        <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center gap-3">
          <i class="fa-solid fa-triangle-exclamation fs-1 text-warning"></i>
          <div>
            <h5 class="fw-bold text-dark mb-1">Your driver account is awaiting admin approval.</h5>
            <p class="mb-0 small text-muted">
              Your license and vehicle details are currently under review by admin. Ride requests and status toggles will be activated once your application is approved.
            </p>
          </div>
        </div>
      <% } %>

      <!-- ACTIVE RIDE BANNER -->
      <% if (typeof activeRide !== 'undefined' && activeRide) { %>
        <div class="alert alert-primary border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center justify-content-between bg-dark text-white">
          <div class="d-flex align-items-center gap-3">
            <div class="brand-icon-box bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
              <i class="fa-solid fa-route fs-4"></i>
            </div>
            <div>
              <span class="badge bg-warning text-dark uppercase fw-bold mb-1"><%= activeRide.status.replace('_', ' ') %></span>
              <h5 class="fw-bold text-white mb-0">Active Trip: <%= activeRide.bookingId %> (<%= activeRide.customer ? activeRide.customer.fullName : 'Passenger' %>)</h5>
              <small class="text-white-80"><i class="fa-solid fa-circle text-success me-1"></i> <%= activeRide.pickup.address %> &rarr; <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= activeRide.destination.address %></small>
            </div>
          </div>
          <a href="/driver/rides/current" class="btn btn-warning rounded-pill fw-bold px-4">
            Manage Ride &rarr;
          </a>
        </div>
      <% } %>

      <!-- REAL STATISTICS CARDS -->
      <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-semibold d-block mb-1">Today's Rides</span>
                <h3 class="fw-bold text-dark mb-0"><%= stats.todayRidesCount %></h3>
              </div>
              <div class="bg-primary-subtle text-primary p-3 rounded-4">
                <i class="fa-solid fa-route fs-4"></i>
              </div>
            </div>
            <div class="mt-3 small text-muted">Completed today</div>
          </div>
        </div>

        <div class="col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-semibold d-block mb-1">Completed Rides</span>
                <h3 class="fw-bold text-dark mb-0"><%= stats.completedRidesCount %></h3>
              </div>
              <div class="bg-success-subtle text-success p-3 rounded-4">
                <i class="fa-solid fa-circle-check fs-4"></i>
              </div>
            </div>
            <div class="mt-3 small text-muted">All-time finished trips</div>
          </div>
        </div>

        <div class="col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-semibold d-block mb-1">Today's Earnings</span>
                <h3 class="fw-bold text-dark mb-0">Rs. <%= stats.todayEarnings %></h3>
              </div>
              <div class="bg-warning-subtle text-warning-emphasis p-3 rounded-4">
                <i class="fa-solid fa-hand-holding-dollar fs-4"></i>
              </div>
            </div>
            <div class="mt-3 small text-muted">Today's payout</div>
          </div>
        </div>

        <div class="col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-semibold d-block mb-1">Driver Rating</span>
                <h3 class="fw-bold text-dark mb-0"><i class="fa-solid fa-star text-warning"></i> <%= stats.rating ? stats.rating.toFixed(1) : '5.0' %></h3>
              </div>
              <div class="bg-dark text-white p-3 rounded-4">
                <i class="fa-solid fa-star-half-stroke fs-4"></i>
              </div>
            </div>
            <div class="mt-3 small text-muted d-flex justify-content-between align-items-center">
              <span><%= typeof stats.totalRatings !== 'undefined' ? stats.totalRatings : 0 %> ratings</span>
              <a href="/driver/ratings" class="text-primary text-decoration-none fw-semibold">View Reviews &rarr;</a>
            </div>
          </div>
        </div>
      </div>

      <!-- AVAILABLE RIDE REQUESTS PREVIEW -->
      <% if (driver.isApproved && driver.driverStatus === 'online') { %>
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-list-check text-warning me-2"></i> Available Ride Requests</h5>
            <a href="/driver/rides/requests" class="text-primary small text-decoration-none fw-semibold">View All Requests &rarr;</a>
          </div>

          <% if (typeof availableRequests !== 'undefined' && availableRequests.length > 0) { %>
            <div class="row g-3">
              <% availableRequests.forEach(function(reqItem) { %>
                <div class="col-md-6">
                  <div class="border rounded-4 p-3 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <span class="badge bg-primary text-white uppercase"><%= reqItem.rideType %></span>
                      <strong class="text-success fs-5">Rs. <%= reqItem.fare %></strong>
                    </div>
                    <div class="small text-dark fw-semibold mb-1">
                      <i class="fa-solid fa-circle text-success me-1"></i> <%= reqItem.pickup.address %>
                    </div>
                    <div class="small text-dark fw-semibold mb-3">
                      <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= reqItem.destination.address %>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                      <span class="small text-muted"><%= reqItem.distance %> KM</span>
                      <div class="d-flex gap-2">
                        <form action="/driver/rides/<%= reqItem._id %>/reject" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Reject</button>
                        </form>
                        <form action="/driver/rides/<%= reqItem._id %>/accept" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold">Accept</button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="text-center py-4 text-muted">
              <i class="fa-solid fa-radar fs-1 mb-2 opacity-50"></i>
              <p class="mb-0">No new ride requests available in your area. Stay online!</p>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- RECENT TRIP HISTORY -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> Recent Trips</h5>
          <a href="/driver/rides/history" class="text-primary small text-decoration-none fw-semibold">View Full History &rarr;</a>
        </div>

        <% if (typeof recentRides !== 'undefined' && recentRides.length > 0) { %>
          <!-- DESKTOP TABLE VIEW -->
          <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="small text-muted">ID & Date</th>
                  <th scope="col" class="small text-muted">Passenger</th>
                  <th scope="col" class="small text-muted">Tier</th>
                  <th scope="col" class="small text-muted">Fare</th>
                  <th scope="col" class="small text-muted">Status</th>
                </tr>
              </thead>
              <tbody>
                <% recentRides.forEach(function(r) { %>
                  <tr>
                    <td>
                      <span class="fw-bold text-dark font-monospace d-block"><%= r.bookingId %></span>
                      <small class="text-muted"><%= new Date(r.createdAt).toLocaleDateString() %></small>
                    </td>
                    <td class="fw-semibold text-dark"><%= r.customer ? r.customer.fullName : 'Customer' %></td>
                    <td><span class="badge bg-primary-subtle text-primary uppercase"><%= r.rideType %></span></td>
                    <td class="fw-bold text-success">Rs. <%= r.fare %></td>
                    <td>
                      <% if (r.status === 'completed') { %>
                        <span class="badge bg-success-subtle text-success">Completed</span>
                      <% } else if (r.status === 'cancelled') { %>
                        <span class="badge bg-danger-subtle text-danger">Cancelled</span>
                      <% } else { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis"><%= r.status %></span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- MOBILE CARD VIEW -->
          <div class="d-block d-md-none">
            <% recentRides.forEach(function(r) { %>
              <div class="card border rounded-3 p-3 mb-2 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-1 pb-2 border-bottom">
                  <span class="fw-bold font-monospace text-dark small"><%= r.bookingId %></span>
                  <% if (r.status === 'completed') { %>
                    <span class="badge bg-success-subtle text-success">Completed</span>
                  <% } else if (r.status === 'cancelled') { %>
                    <span class="badge bg-danger-subtle text-danger">Cancelled</span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis"><%= r.status %></span>
                  <% } %>
                </div>
                <div class="d-flex justify-content-between align-items-center small mt-2">
                  <span class="text-muted"><i class="fa-solid fa-user me-1"></i> <%= r.customer ? r.customer.fullName : 'Customer' %></span>
                  <strong class="text-success">Rs. <%= r.fare %></strong>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center py-4 text-muted">
            <p class="mb-0">No trip history found.</p>
          </div>
        <% } %>
      </div>

    </main>
  </div>
</div>
