<div class="container py-4 my-md-2">
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="fw-extrabold text-dark mb-1">Driver Trip History</h3>
      <p class="text-muted mb-0">Record of all completed and past assigned trips</p>
    </div>
    <a href="/driver/dashboard" class="btn btn-outline-secondary rounded-pill fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
    </a>
  </div>

  <% if (rides && rides.length > 0) { %>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
      
      <!-- DESKTOP TABLE VIEW -->
      <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="py-3 ps-4">Booking ID</th>
              <th scope="col" class="py-3">Passenger</th>
              <th scope="col" class="py-3">Route</th>
              <th scope="col" class="py-3">Tier</th>
              <th scope="col" class="py-3">Fare & Distance</th>
              <th scope="col" class="py-3">Status</th>
              <th scope="col" class="py-3 pe-4 text-end">Date</th>
            </tr>
          </thead>
          <tbody>
            <% rides.forEach(function(ride) { %>
              <tr>
                <td class="ps-4">
                  <span class="fw-bold font-monospace text-dark d-block"><%= ride.bookingId %></span>
                </td>
                <td>
                  <span class="fw-semibold text-dark"><%= ride.customer ? ride.customer.fullName : 'Passenger' %></span>
                </td>
                <td style="max-width: 250px;">
                  <div class="d-flex flex-column gap-1 small">
                    <span class="text-truncate text-dark fw-semibold">
                      <i class="fa-solid fa-circle text-success me-1"></i> <%= ride.pickup.address %>
                    </span>
                    <span class="text-truncate text-dark fw-semibold">
                      <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= ride.destination.address %>
                    </span>
                  </div>
                </td>
                <td>
                  <span class="badge bg-primary-subtle text-primary uppercase"><%= ride.rideType %></span>
                </td>
                <td>
                  <div class="fw-bold text-success">Rs. <%= ride.fare %></div>
                  <small class="text-muted"><%= ride.distance %> KM</small>
                </td>
                <td>
                  <% if (ride.status === 'completed') { %>
                    <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-check me-1"></i> Completed</span>
                  <% } else if (ride.status === 'cancelled') { %>
                    <span class="badge bg-danger-subtle text-danger"><i class="fa-solid fa-ban me-1"></i> Cancelled</span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis"><%= ride.status %></span>
                  <% } %>
                </td>
                <td class="pe-4 text-end">
                  <small class="text-muted"><%= new Date(ride.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></small>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- MOBILE CARD VIEW -->
      <div class="d-block d-md-none p-3">
        <% rides.forEach(function(ride) { %>
          <div class="card border rounded-3 p-3 mb-3 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
              <span class="fw-bold font-monospace text-dark small"><%= ride.bookingId %></span>
              <% if (ride.status === 'completed') { %>
                <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-check me-1"></i> Completed</span>
              <% } else if (ride.status === 'cancelled') { %>
                <span class="badge bg-danger-subtle text-danger"><i class="fa-solid fa-ban me-1"></i> Cancelled</span>
              <% } else { %>
                <span class="badge bg-warning-subtle text-warning-emphasis"><%= ride.status %></span>
              <% } %>
            </div>
            <div class="mb-2">
              <div class="small fw-semibold text-dark mb-1"><i class="fa-solid fa-user me-1 text-muted"></i> Passenger: <%= ride.customer ? ride.customer.fullName : 'Passenger' %></div>
              <div class="small text-muted mb-1"><i class="fa-solid fa-circle text-success me-1 fs-8"></i> <%= ride.pickup.address %></div>
              <div class="small text-dark fw-semibold"><i class="fa-solid fa-location-dot text-danger me-1 fs-8"></i> <%= ride.destination.address %></div>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
              <div>
                <span class="badge bg-primary-subtle text-primary uppercase me-1"><%= ride.rideType %></span>
                <strong class="text-success small">Rs. <%= ride.fare %></strong>
              </div>
              <small class="text-muted"><%= new Date(ride.createdAt).toLocaleDateString() %></small>
            </div>
          </div>
        <% }); %>
      </div>

    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="card border-0 shadow-lg rounded-4 text-center p-5">
      <div class="max-w-600 mx-auto py-4">
        <div class="icon-box-lg bg-light text-muted rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
          <i class="fa-solid fa-clock-rotate-left display-4"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">No ride history yet</h4>
        <p class="text-muted mb-4">Your completed trips and earnings history will appear here.</p>
        <a href="/driver/dashboard" class="btn btn-primary rounded-pill px-5 fw-bold">
          Return to Dashboard
        </a>
      </div>
    </div>
  <% } %>

</div>
