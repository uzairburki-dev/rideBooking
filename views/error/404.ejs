<div class="container py-5 my-5 text-center">
  <div class="max-w-600 mx-auto">
    <div class="display-1 fw-extrabold text-primary mb-3">404</div>
    <div class="error-illustration mb-4">
      <i class="fa-solid fa-map-location-dot fs-1 text-muted"></i>
    </div>
    <h2 class="fw-bold text-dark mb-3">Destination Not Found</h2>
    <p class="text-muted lead mb-4">
      The route or page you are looking for (<code class="bg-light px-2 py-1 rounded text-danger"><%= typeof url !== 'undefined' ? url : '' %></code>) does not exist or has been moved.
    </p>
    <a href="/" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
      <i class="fa-solid fa-house me-2"></i> Back to Home
    </a>
  </div>
</div>
