<div class="container py-4 my-md-2">
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="fw-extrabold text-dark mb-1">Pending Driver Approvals Queue</h3>
      <p class="text-muted mb-0">Review driver license credentials, vehicle details, and grant driving privileges</p>
    </div>
    <a href="/admin/drivers" class="btn btn-outline-secondary rounded-pill fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i> All Drivers
    </a>
  </div>

  <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-warning text-dark p-3 fw-bold border-0 d-flex justify-content-between align-items-center">
      <span><i class="fa-solid fa-clock-rotate-left me-2"></i> Pending Applications (<%= drivers.length %>)</span>
    </div>

    <% if (drivers && drivers.length > 0) { %>
      <div class="list-group list-group-flush">
        <% drivers.forEach(function(d) { %>
          <div class="list-group-item p-4">
            <div class="row align-items-center g-3">
              
              <!-- Driver Details -->
              <div class="col-md-5">
                <div class="d-flex align-items-center gap-3">
                  <div class="avatar-circle bg-dark text-white fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fa-solid fa-user-tie fs-4"></i>
                  </div>
                  <div>
                    <h5 class="fw-bold text-dark mb-0"><%= d.user ? d.user.fullName : 'Driver' %></h5>
                    <div class="text-muted small"><%= d.user ? d.user.email : '' %> &bull; <%= d.user ? d.user.phone : '' %></div>
                    <small class="text-primary fw-semibold">License No: <span class="font-monospace"><%= d.licenseNumber %></span></small>
                  </div>
                </div>
              </div>

              <!-- Vehicle Details -->
              <div class="col-md-4">
                <% if (d.vehicle) { %>
                  <div class="p-2 bg-light rounded-3 border small">
                    <span class="text-muted d-block">Vehicle Info:</span>
                    <strong><%= d.vehicle.brand %> <%= d.vehicle.model %> (<%= d.vehicle.year %>, <%= d.vehicle.color %>)</strong>
                    <div class="font-monospace text-primary fw-bold"><%= d.vehicle.registrationNumber %> &bull; <%= d.vehicle.seats %> Seats</div>
                  </div>
                <% } else { %>
                  <span class="text-muted small">No vehicle linked</span>
                <% } %>
              </div>

              <!-- Actions -->
              <div class="col-md-3 text-end">
                <div class="d-flex flex-column gap-2">
                  <form action="/admin/drivers/<%= d._id %>/approve" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-success btn-sm rounded-pill w-100 fw-bold">
                      <i class="fa-solid fa-check me-1"></i> Approve Driver
                    </button>
                  </form>
                  
                  <button type="button" class="btn btn-outline-danger btn-sm rounded-pill w-100 fw-semibold" data-bs-toggle="modal" data-bs-target="#rejectModal<%= d._id %>">
                    <i class="fa-solid fa-xmark me-1"></i> Reject Application
                  </button>
                </div>
              </div>

            </div>
          </div>

          <!-- REJECTION REASON MODAL -->
          <div class="modal fade" id="rejectModal<%= d._id %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 bg-danger text-white">
                  <h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i> Reject Driver Application</h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form action="/admin/drivers/<%= d._id %>/reject" method="POST">
                  <div class="modal-body p-4 text-start">
                    <p class="text-dark mb-3">Reject application for <strong><%= d.user ? d.user.fullName : 'this driver' %></strong>?</p>
                    
                    <div class="mb-3">
                      <label for="rejectionReason<%= d._id %>" class="form-label fw-semibold text-dark small">Reason for Rejection (optional)</label>
                      <textarea class="form-control rounded-3" name="rejectionReason" id="rejectionReason<%= d._id %>" rows="3" placeholder="Provide reason for rejection (e.g. Invalid license credentials, vehicle details incomplete)..."></textarea>
                    </div>
                  </div>

                  <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill fw-bold px-4">Confirm Rejection</button>
                  </div>
                </form>

              </div>
            </div>
          </div>

        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <i class="fa-solid fa-circle-check text-success fs-1 mb-2 opacity-50"></i>
        <h5 class="fw-bold text-dark mb-1">Approval queue clear!</h5>
        <p class="text-muted mb-0">There are currently no driver applications waiting for review.</p>
      </div>
    <% } %>
  </div>

</div>
