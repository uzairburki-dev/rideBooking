<div class="container py-4 my-md-2">
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <a href="/admin/rides" class="btn btn-outline-secondary rounded-pill fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i> Ride Log Management
    </a>
  </div>

  <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-dark text-white p-4 d-flex align-items-center justify-content-between">
      <div>
        <span class="text-warning small font-monospace d-block">System Booking Inspection</span>
        <h3 class="fw-bold text-white mb-0 font-monospace"><%= ride.bookingId %></h3>
      </div>
      <div>
        <% if (ride.status === 'completed') { %>
          <span class="badge bg-success px-3 py-2 fs-6 rounded-pill">Completed</span>
        <% } else if (ride.status === 'cancelled') { %>
          <span class="badge bg-danger px-3 py-2 fs-6 rounded-pill">Cancelled</span>
        <% } else { %>
          <span class="badge bg-info text-white px-3 py-2 fs-6 rounded-pill uppercase"><%= ride.status %></span>
        <% } %>
      </div>
    </div>

    <div class="card-body p-4 p-md-5">
      
      <!-- Route & Specs Split -->
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <div class="p-3 bg-light rounded-4 border h-100">
            <span class="text-success fw-bold small d-block mb-1"><i class="fa-solid fa-circle me-1"></i> PICKUP LOCATION</span>
            <strong class="text-dark"><%= ride.pickup.address %></strong>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 bg-light rounded-4 border h-100">
            <span class="text-danger fw-bold small d-block mb-1"><i class="fa-solid fa-location-dot me-1"></i> DESTINATION</span>
            <strong class="text-dark"><%= ride.destination.address %></strong>
          </div>
        </div>
      </div>

      <div class="row g-3 p-3 bg-light rounded-4 border mb-4 text-center">
        <div class="col-4">
          <span class="text-muted small fw-semibold d-block">Tier</span>
          <span class="badge bg-primary text-white uppercase"><%= ride.rideType %></span>
        </div>
        <div class="col-4">
          <span class="text-muted small fw-semibold d-block">Distance</span>
          <strong class="text-dark"><%= ride.distance %> KM</strong>
        </div>
        <div class="col-4">
          <span class="text-muted small fw-semibold d-block">Calculated Fare</span>
          <strong class="text-success fs-5">Rs. <%= ride.fare %></strong>
        </div>
      </div>

      <!-- Parties Split -->
      <div class="row g-4 mb-4">
        <!-- Customer Info -->
        <div class="col-md-6">
          <div class="p-4 bg-light rounded-4 border h-100">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fa-solid fa-user text-info me-2"></i> Passenger Details</h6>
            <% if (ride.customer) { %>
              <div class="small text-dark">
                <div class="mb-2"><span class="text-muted">Name:</span> <strong><%= ride.customer.fullName %></strong></div>
                <div class="mb-2"><span class="text-muted">Email:</span> <strong><%= ride.customer.email %></strong></div>
                <div class="mb-2"><span class="text-muted">Phone:</span> <strong class="font-monospace"><%= ride.customer.phone %></strong></div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Driver Info -->
        <div class="col-md-6">
          <div class="p-4 bg-light rounded-4 border h-100">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fa-solid fa-id-card-clip text-warning me-2"></i> Driver & Vehicle</h6>
            <% if (ride.driver && ride.driver.user) { %>
              <div class="small text-dark">
                <div class="mb-2"><span class="text-muted">Name:</span> <strong><%= ride.driver.user.fullName %></strong></div>
                <div class="mb-2"><span class="text-muted">Phone:</span> <strong class="font-monospace"><%= ride.driver.user.phone %></strong></div>
                <% if (ride.driver.vehicle) { %>
                  <div class="mb-2"><span class="text-muted">Vehicle:</span> <strong><%= ride.driver.vehicle.brand %> <%= ride.driver.vehicle.model %> (<%= ride.driver.vehicle.registrationNumber %>)</strong></div>
                <% } %>
              </div>
            <% } else { %>
              <div class="text-muted small">No driver assigned yet.</div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Payment & Review Linked Info -->
      <div class="row g-4 mb-4">
        <!-- Payment Information -->
        <div class="col-md-6">
          <div class="p-4 bg-white border rounded-4 h-100">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fa-solid fa-receipt text-success me-2"></i> Payment Record</h6>
            <% if (payment) { %>
              <div class="small text-dark">
                <div class="mb-2"><span class="text-muted">Txn Ref:</span> <strong class="font-monospace text-primary"><%= payment.transactionReference %></strong></div>
                <div class="mb-2"><span class="text-muted">Method:</span> <strong><%= payment.method %></strong></div>
                <div class="mb-2"><span class="text-muted">Amount:</span> <strong class="text-success">Rs. <%= payment.amount %></strong></div>
                <div class="mb-2"><span class="text-muted">Status:</span> <span class="badge <%= payment.status === 'paid' ? 'bg-success' : 'bg-warning text-dark' %>"><%= payment.status %></span></div>
              </div>
            <% } else { %>
              <div class="text-muted small">Ride payment is <strong class="text-warning">Pending</strong> (No transaction record created yet).</div>
            <% } %>
          </div>
        </div>

        <!-- Review Information -->
        <div class="col-md-6">
          <div class="p-4 bg-white border rounded-4 h-100">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fa-solid fa-star text-warning me-2"></i> Rating & Review</h6>
            <% if (review) { %>
              <div class="small text-dark">
                <div class="mb-2"><span class="text-muted">Rating Given:</span> <span class="badge bg-warning text-dark"><i class="fa-solid fa-star"></i> <%= review.rating %> / 5</span></div>
                <div class="mb-2"><span class="text-muted">Comment:</span> <em>"<%= review.comment || 'No comment provided' %>"</em></div>
              </div>
            <% } else { %>
              <div class="text-muted small">No customer rating or review submitted for this trip.</div>
            <% } %>
          </div>
        </div>
      </div>

    </div>
  </div>

</div>
