<div class="container py-4 my-md-2">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h3 class="fw-extrabold text-dark mb-1">Master Payment Log</h3>
      <p class="text-muted mb-0">Monitor financial transactions, settled payouts, and payment records</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary rounded-pill fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
    </a>
  </div>

  <!-- Search & Filter Controls -->
  <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form action="/admin/payments" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-6">
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
          <input type="text" name="search" class="form-control border-start-0 bg-light font-monospace" placeholder="Search by Transaction Ref or Payment ID..." value="<%= search %>">
        </div>
      </div>
      <div class="col-12 col-md-4">
        <select name="status" class="form-select bg-light" onchange="this.form.submit()">
          <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>All Payment Statuses</option>
          <option value="paid" <%= currentStatus === 'paid' ? 'selected' : '' %>>Paid / Settled</option>
          <option value="pending" <%= currentStatus === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="failed" <%= currentStatus === 'failed' ? 'selected' : '' %>>Failed</option>
          <option value="refunded" <%= currentStatus === 'refunded' ? 'selected' : '' %>>Refunded</option>
        </select>
      </div>
      <div class="col-12 col-md-2 d-grid">
        <button type="submit" class="btn btn-primary rounded-pill fw-bold">Filter</button>
      </div>
    </form>
  </div>

  <!-- Payments Table Card -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-dark text-white p-3 fw-bold border-0 d-flex justify-content-between align-items-center">
      <span><i class="fa-solid fa-wallet text-success me-2"></i> System Payment Transactions</span>
      <span class="badge bg-secondary rounded-pill"><%= payments.length %> Transactions</span>
    </div>

    <% if (payments && payments.length > 0) { %>
      
      <!-- DESKTOP TABLE VIEW -->
      <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="py-3 ps-4">Txn Reference</th>
              <th scope="col" class="py-3">Booking ID</th>
              <th scope="col" class="py-3">Customer</th>
              <th scope="col" class="py-3">Amount</th>
              <th scope="col" class="py-3">Method</th>
              <th scope="col" class="py-3">Status</th>
              <th scope="col" class="py-3">Date</th>
              <th scope="col" class="py-3 pe-4 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% payments.forEach(function(p) { %>
              <tr>
                <td class="ps-4 fw-bold font-monospace text-primary"><%= p.transactionReference %></td>
                <td class="fw-semibold font-monospace text-dark"><%= p.ride ? p.ride.bookingId : 'N/A' %></td>
                <td class="fw-semibold text-dark"><%= p.customer ? p.customer.fullName : 'Customer' %></td>
                <td class="fw-extrabold text-success">Rs. <%= p.amount %></td>
                <td><span class="badge bg-light text-dark border"><%= p.method %></span></td>
                <td>
                  <% if (p.status === 'paid') { %>
                    <span class="badge bg-success-subtle text-success">Paid</span>
                  <% } else if (p.status === 'pending') { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis">Pending</span>
                  <% } else if (p.status === 'failed') { %>
                    <span class="badge bg-danger-subtle text-danger">Failed</span>
                  <% } else { %>
                    <span class="badge bg-secondary uppercase"><%= p.status %></span>
                  <% } %>
                </td>
                <td class="small text-muted"><%= new Date(p.createdAt).toLocaleDateString() %></td>
                <td class="pe-4 text-end">
                  <a href="/admin/payments/<%= p._id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                    Receipt
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- MOBILE CARD VIEW -->
      <div class="d-block d-md-none p-3">
        <% payments.forEach(function(p) { %>
          <div class="card border rounded-3 p-3 mb-3 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
              <span class="fw-bold font-monospace text-primary small"><%= p.transactionReference %></span>
              <% if (p.status === 'paid') { %>
                <span class="badge bg-success-subtle text-success">Paid</span>
              <% } else if (p.status === 'pending') { %>
                <span class="badge bg-warning-subtle text-warning-emphasis">Pending</span>
              <% } else if (p.status === 'failed') { %>
                <span class="badge bg-danger-subtle text-danger">Failed</span>
              <% } else { %>
                <span class="badge bg-secondary uppercase"><%= p.status %></span>
              <% } %>
            </div>
            <div class="mb-2">
              <div class="small fw-semibold text-dark mb-1"><i class="fa-solid fa-user me-1 text-muted"></i> <%= p.customer ? p.customer.fullName : 'Customer' %></div>
              <div class="small text-muted mb-1">Booking: <strong class="font-monospace text-dark"><%= p.ride ? p.ride.bookingId : 'N/A' %></strong></div>
              <div class="small text-muted">Method: <span class="badge bg-light text-dark border me-1"><%= p.method %></span> Date: <%= new Date(p.createdAt).toLocaleDateString() %></div>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
              <span class="fw-extrabold text-success fs-5">Rs. <%= p.amount %></span>
              <a href="/admin/payments/<%= p._id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">Receipt</a>
            </div>
          </div>
        <% }); %>
      </div>

    <% } else { %>
      <div class="text-center py-5">
        <i class="fa-solid fa-receipt text-muted fs-1 mb-2 opacity-50"></i>
        <h5 class="fw-bold text-dark mb-1">No payment transactions found</h5>
        <p class="text-muted mb-0">Try adjusting your search query or filter selection.</p>
      </div>
    <% } %>
  </div>

</div>
