<div class="dashboard-wrapper container-fluid p-0">
  <div class="row g-0 min-vh-100">
    
    <!-- ADMIN DASHBOARD SIDEBAR -->
    <aside class="col-lg-2 bg-dark text-white p-3 dashboard-sidebar d-flex flex-column" id="dashboardSidebar">
      <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom border-secondary opacity-75">
        <a href="/" class="d-flex align-items-center gap-2 text-white text-decoration-none">
          <div class="brand-icon-box bg-danger text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
            <i class="fa-solid fa-user-shield"></i>
          </div>
          <span class="fw-bold fs-5">Ride<span class="text-primary">Go</span></span>
        </a>
        <button class="btn btn-sm btn-outline-secondary text-white d-lg-none" id="closeSidebarBtn">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Navigation Menu -->
      <ul class="nav nav-pills flex-column mb-auto dashboard-nav gap-1">
        <li class="nav-item">
          <a href="/admin/dashboard" class="nav-link active bg-danger text-white d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold">
            <i class="fa-solid fa-gauge"></i> Dashboard
          </a>
        </li>
        <li class="nav-item">
          <a href="/admin/customers" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-users text-info"></i> Customers
          </a>
        </li>
        <li class="nav-item">
          <a href="/admin/drivers" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-id-card-clip text-warning"></i> Drivers
          </a>
        </li>
        <li class="nav-item">
          <a href="/admin/drivers/pending" class="nav-link text-white-80 d-flex align-items-center justify-content-between rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <span><i class="fa-solid fa-clock-rotate-left text-warning"></i> Approvals</span>
            <% if (stats.pendingDrivers > 0) { %>
              <span class="badge bg-warning text-dark rounded-pill"><%= stats.pendingDrivers %></span>
            <% } %>
          </a>
        </li>
        <li class="nav-item">
          <a href="/admin/rides" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-route text-primary"></i> Rides
          </a>
        </li>
        <li class="nav-item">
          <a href="/admin/payments" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-wallet text-success"></i> Payments
          </a>
        </li>
        <li class="nav-item">
          <a href="/admin/reviews" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-star text-warning"></i> Reviews
          </a>
        </li>
        <li class="nav-item">
          <a href="/admin/reports" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-chart-pie text-secondary"></i> Reports
          </a>
        </li>
        <li class="nav-item">
          <a href="/profile" class="nav-link text-white-80 d-flex align-items-center gap-3 rounded-3 px-3 py-2 fw-semibold hover-bg-dark-subtle">
            <i class="fa-solid fa-user"></i> My Profile
          </a>
        </li>
      </ul>

      <!-- User Profile Footer -->
      <div class="pt-3 mt-auto border-top border-secondary opacity-75">
        <div class="d-flex align-items-center gap-2 mb-3">
          <div class="avatar-circle bg-danger text-white fw-bold d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-shield-cat"></i>
          </div>
          <div class="overflow-hidden">
            <h6 class="mb-0 text-white fw-bold text-truncate"><%= user.fullName %></h6>
            <span class="badge bg-danger text-white small px-2 py-0">Administrator</span>
          </div>
        </div>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-semibold">
            <i class="fa-solid fa-right-from-bracket me-1"></i> Sign Out
          </button>
        </form>
      </div>
    </aside>

    <!-- MAIN ADMIN CONTENT AREA -->
    <main class="col-lg-10 bg-light p-3 p-md-4 p-lg-5 dashboard-main">
      
      <!-- Top Bar Header -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 mb-lg-5 bg-white p-3.5 p-md-4 rounded-4 shadow-sm border">
        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-dark d-lg-none shadow-sm" id="openSidebarBtn" aria-label="Open navigation sidebar">
            <i class="fa-solid fa-bars"></i>
          </button>
          <div>
            <h4 class="fw-bold text-dark mb-0 fs-5 fs-md-4">System Administration Console</h4>
            <small class="text-muted">Welcome back, <%= user.fullName %></small>
          </div>
        </div>
        <div>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-bold text-wrap text-start">
            <i class="fa-solid fa-shield-halved me-1"></i> Admin Authorization Active
          </span>
        </div>
      </div>

      <!-- PENDING DRIVERS ALERT BANNER -->
      <% if (stats.pendingDrivers > 0) { %>
        <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-4 mb-lg-5 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-warning text-dark p-3 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
              <i class="fa-solid fa-clock-rotate-left fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold text-dark mb-1"><%= stats.pendingDrivers %> Driver <%= stats.pendingDrivers === 1 ? 'Application' : 'Applications' %> Awaiting Approval</h5>
              <p class="mb-0 small text-muted">Review driver licenses and vehicle details before granting access to receive ride requests.</p>
            </div>
          </div>
          <a href="/admin/drivers/pending" class="btn btn-warning rounded-pill fw-bold px-4 py-2 text-nowrap flex-shrink-0">
            Review Drivers &rarr;
          </a>
        </div>
      <% } %>

      <!-- REAL DATABASE STATISTICS CARDS -->
      <div class="row g-3 g-md-4 mb-4 mb-lg-5">
        <!-- Customers -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 transition-all">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-semibold d-block mb-1">Total Customers</span>
                <h3 class="fw-bold text-dark mb-0 display-6"><%= stats.totalCustomers %></h3>
              </div>
              <div class="bg-info-subtle text-info p-3 rounded-4">
                <i class="fa-solid fa-users fs-3"></i>
              </div>
            </div>
            <div class="mt-3 pt-3 border-top border-light-subtle small text-muted">
              <span class="fw-semibold text-success"><%= stats.activeCustomers %> Active</span> &bull; <span><%= stats.inactiveCustomers %> Inactive</span>
            </div>
          </div>
        </div>

        <!-- Drivers -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 transition-all">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-semibold d-block mb-1">Fleet Drivers</span>
                <h3 class="fw-bold text-dark mb-0 display-6"><%= stats.totalDrivers %></h3>
              </div>
              <div class="bg-warning-subtle text-warning-emphasis p-3 rounded-4">
                <i class="fa-solid fa-id-card-clip fs-3"></i>
              </div>
            </div>
            <div class="mt-3 pt-3 border-top border-light-subtle small text-muted">
              <span class="fw-semibold text-primary"><%= stats.approvedDrivers %> Approved</span> &bull; <span><%= stats.pendingDrivers %> Pending</span>
            </div>
          </div>
        </div>

        <!-- Completed Rides -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 transition-all">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-semibold d-block mb-1">Total Rides</span>
                <h3 class="fw-bold text-dark mb-0 display-6"><%= stats.totalRides %></h3>
              </div>
              <div class="bg-primary-subtle text-primary p-3 rounded-4">
                <i class="fa-solid fa-route fs-3"></i>
              </div>
            </div>
            <div class="mt-3 pt-3 border-top border-light-subtle small text-muted">
              <span class="fw-semibold text-success"><%= stats.completedRides %> Completed</span> &bull; <span><%= stats.activeRides %> Active</span>
            </div>
          </div>
        </div>

        <!-- System Revenue -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 transition-all">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-semibold d-block mb-1">Total Paid Revenue</span>
                <h3 class="fw-bold text-success mb-0 fs-3">Rs. <%= stats.totalRevenue %></h3>
              </div>
              <div class="bg-success-subtle text-success p-3 rounded-4">
                <i class="fa-solid fa-vault fs-3"></i>
              </div>
            </div>
            <div class="mt-3 pt-3 border-top border-light-subtle small text-muted">
              <span class="fw-semibold text-dark"><%= stats.paidPaymentsCount %> settled payments</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RECENT RIDES & PAYMENTS GRID -->
      <div class="row g-4 g-lg-5 mb-4 mb-lg-5">
        <!-- Recent Rides -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-light-subtle">
              <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> Recent Rides</h5>
              <a href="/admin/rides" class="text-primary small text-decoration-none fw-semibold">View All &rarr;</a>
            </div>

            <% if (recentRides && recentRides.length > 0) { %>
              <!-- DESKTOP TABLE VIEW -->
              <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0 small">
                  <thead class="table-light">
                    <tr>
                      <th class="py-3">Booking ID</th>
                      <th class="py-3">Customer</th>
                      <th class="py-3">Fare</th>
                      <th class="py-3 text-end">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% recentRides.forEach(function(r) { %>
                      <tr>
                        <td class="fw-bold font-monospace text-primary py-3"><%= r.bookingId %></td>
                        <td class="fw-semibold text-dark py-3"><%= r.customer ? r.customer.fullName : 'Customer' %></td>
                        <td class="fw-bold text-success py-3">Rs. <%= r.fare %></td>
                        <td class="py-3 text-end">
                          <span class="badge <%= r.status === 'completed' ? 'bg-success-subtle text-success' : r.status === 'cancelled' ? 'bg-danger-subtle text-danger' : 'bg-warning-subtle text-warning-emphasis' %>">
                            <%= r.status %>
                          </span>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <!-- MOBILE CARD VIEW -->
              <div class="d-block d-md-none">
                <% recentRides.forEach(function(r) { %>
                  <div class="card border rounded-3 p-3 mb-3 bg-white shadow-xs">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                      <span class="fw-bold font-monospace text-primary small"><%= r.bookingId %></span>
                      <span class="badge <%= r.status === 'completed' ? 'bg-success-subtle text-success' : r.status === 'cancelled' ? 'bg-danger-subtle text-danger' : 'bg-warning-subtle text-warning-emphasis' %>">
                        <%= r.status %>
                      </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center small">
                      <span class="text-muted"><%= r.customer ? r.customer.fullName : 'Customer' %></span>
                      <strong class="text-success">Rs. <%= r.fare %></strong>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="text-center py-4 text-muted small">No rides recorded yet.</div>
            <% } %>
          </div>
        </div>

        <!-- Recent Payments -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-light-subtle">
              <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-receipt text-success me-2"></i> Recent Payments</h5>
              <a href="/admin/payments" class="text-primary small text-decoration-none fw-semibold">View All &rarr;</a>
            </div>

            <% if (recentPayments && recentPayments.length > 0) { %>
              <!-- DESKTOP TABLE VIEW -->
              <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0 small">
                  <thead class="table-light">
                    <tr>
                      <th class="py-3">Txn Ref</th>
                      <th class="py-3">Customer</th>
                      <th class="py-3">Amount</th>
                      <th class="py-3 text-end">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% recentPayments.forEach(function(p) { %>
                      <tr>
                        <td class="fw-bold font-monospace text-primary py-3 text-truncate" style="max-width: 140px;"><%= p.transactionReference %></td>
                        <td class="fw-semibold text-dark py-3"><%= p.customer ? p.customer.fullName : 'Customer' %></td>
                        <td class="fw-bold text-success py-3">Rs. <%= p.amount %></td>
                        <td class="py-3 text-end">
                          <span class="badge <%= p.status === 'paid' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning-emphasis' %>">
                            <%= p.status %>
                          </span>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <!-- MOBILE CARD VIEW -->
              <div class="d-block d-md-none">
                <% recentPayments.forEach(function(p) { %>
                  <div class="card border rounded-3 p-3 mb-3 bg-white shadow-xs">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                      <span class="fw-bold font-monospace text-primary small text-truncate" style="max-width: 160px;"><%= p.transactionReference %></span>
                      <span class="badge <%= p.status === 'paid' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning-emphasis' %>">
                        <%= p.status %>
                      </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center small">
                      <span class="text-muted"><%= p.customer ? p.customer.fullName : 'Customer' %></span>
                      <strong class="text-success">Rs. <%= p.amount %></strong>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="text-center py-4 text-muted small">No payment transactions recorded yet.</div>
            <% } %>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>
