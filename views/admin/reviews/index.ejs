<div class="container py-4 my-md-2">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h3 class="fw-extrabold text-dark mb-1">Customer Reviews & Ratings</h3>
      <p class="text-muted mb-0">Monitor passenger feedback, ratings, and moderate reviews</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary rounded-pill fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i> Dashboard
    </a>
  </div>

  <!-- Filter Controls -->
  <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form action="/admin/reviews" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-8">
        <label for="ratingFilter" class="form-label small fw-semibold text-muted mb-1">Filter by Rating</label>
        <select id="ratingFilter" name="rating" class="form-select bg-light" onchange="this.form.submit()">
          <option value="all" <%= currentRating === 'all' ? 'selected' : '' %>>All Ratings (1 to 5 Stars)</option>
          <option value="5" <%= currentRating === '5' ? 'selected' : '' %>>5 Stars ⭐⭐⭐⭐⭐</option>
          <option value="4" <%= currentRating === '4' ? 'selected' : '' %>>4 Stars ⭐⭐⭐⭐</option>
          <option value="3" <%= currentRating === '3' ? 'selected' : '' %>>3 Stars ⭐⭐⭐</option>
          <option value="2" <%= currentRating === '2' ? 'selected' : '' %>>2 Stars ⭐⭐</option>
          <option value="1" <%= currentRating === '1' ? 'selected' : '' %>>1 Star ⭐</option>
        </select>
      </div>
      <div class="col-12 col-md-4 d-grid align-self-end">
        <button type="submit" class="btn btn-primary rounded-pill fw-bold">Filter Reviews</button>
      </div>
    </form>
  </div>

  <!-- Reviews Card -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-dark text-white p-3 fw-bold border-0 d-flex justify-content-between align-items-center">
      <span><i class="fa-solid fa-star text-warning me-2"></i> All Customer Reviews</span>
      <span class="badge bg-secondary rounded-pill"><%= reviews.length %> Reviews</span>
    </div>

    <% if (reviews && reviews.length > 0) { %>
      
      <!-- DESKTOP TABLE VIEW -->
      <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="py-3 ps-4">Customer</th>
              <th scope="col" class="py-3">Driver</th>
              <th scope="col" class="py-3">Booking ID</th>
              <th scope="col" class="py-3">Rating</th>
              <th scope="col" class="py-3">Comment</th>
              <th scope="col" class="py-3">Date</th>
              <th scope="col" class="py-3 pe-4 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% reviews.forEach(function(r) { %>
              <tr>
                <td class="ps-4 fw-bold text-dark"><%= r.customer ? r.customer.fullName : 'Customer' %></td>
                <td class="fw-semibold text-dark"><%= (r.driver && r.driver.user) ? r.driver.user.fullName : 'Driver' %></td>
                <td class="fw-semibold font-monospace text-primary"><%= r.ride ? r.ride.bookingId : 'N/A' %></td>
                <td>
                  <div class="text-warning small">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="fa-<%= i <= r.rating ? 'solid' : 'regular' %> fa-star"></i>
                    <% } %>
                    <span class="ms-1 fw-bold text-dark">(<%= r.rating %>/5)</span>
                  </div>
                </td>
                <td class="text-muted small" style="max-width: 250px;"><%= r.comment || 'No comment provided' %></td>
                <td class="small text-muted"><%= new Date(r.createdAt).toLocaleDateString() %></td>
                <td class="pe-4 text-end">
                  <form action="/admin/reviews/<%= r._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                      <i class="fa-solid fa-trash me-1"></i> Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- MOBILE CARD VIEW -->
      <div class="d-block d-md-none p-3">
        <% reviews.forEach(function(r) { %>
          <div class="card border rounded-3 p-3 mb-3 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
              <span class="fw-bold text-dark"><%= r.customer ? r.customer.fullName : 'Customer' %></span>
              <div class="text-warning small">
                <% for (let i = 1; i <= 5; i++) { %>
                  <i class="fa-<%= i <= r.rating ? 'solid' : 'regular' %> fa-star"></i>
                <% } %>
              </div>
            </div>
            <div class="mb-2">
              <div class="small text-muted mb-1">Driver: <strong class="text-dark"><%= (r.driver && r.driver.user) ? r.driver.user.fullName : 'Driver' %></strong></div>
              <div class="small text-muted mb-1">Booking: <strong class="font-monospace text-primary"><%= r.ride ? r.ride.bookingId : 'N/A' %></strong></div>
              <div class="small text-muted italic my-2">"<%= r.comment || 'No comment provided' %>"</div>
              <div class="small text-muted">Date: <%= new Date(r.createdAt).toLocaleDateString() %></div>
            </div>
            <div class="pt-2 border-top mt-2 text-end">
              <form action="/admin/reviews/<%= r._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?');">
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                  <i class="fa-solid fa-trash me-1"></i> Delete Review
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>

    <% } else { %>
      <div class="text-center py-5">
        <i class="fa-solid fa-star-half-stroke text-muted fs-1 mb-2 opacity-50"></i>
        <h5 class="fw-bold text-dark mb-1">No reviews found</h5>
        <p class="text-muted mb-0">No customer reviews match your selected filter.</p>
      </div>
    <% } %>
  </div>

</div>
